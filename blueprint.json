{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"landingPage": "/wp-admin/admin.php?page=graphiql-ide",
	"login": true,
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "wp-graphql"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/wpengine/wp-graphql-content-blocks/preview-main/wp-graphql-content-blocks.zip"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; wp_insert_post( array( 'post_title' => 'Content Blocks Demo', 'post_name' => 'content-blocks-demo', 'post_status' => 'publish', 'post_content' => '<!-- wp:heading -->\n<h2 class=\"wp-block-heading\" id=\"blocks-as-data\">Blocks as data</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Query this post&#8217;s blocks through the <code>editorBlocks</code> field in GraphiQL.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Headings and paragraphs</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Lists, quotes, and code</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Columns and buttons</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p>Inner blocks come back flat, linked by <code>parentClientId</code>.</p>\n<!-- /wp:paragraph --></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph -->\n<p>Left column</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph -->\n<p>Right column</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:code -->\n<pre class=\"wp-block-code\"><code>query { posts { nodes { editorBlocks { name } } } }</code></pre>\n<!-- /wp:code -->\n\n<!-- wp:separator -->\n<hr class=\"wp-block-separator has-alpha-channel-opacity\"/>\n<!-- /wp:separator -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://github.com/wpengine/wp-graphql-content-blocks\">View on GitHub</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->' ) ); ?>"
		}
	]
}
